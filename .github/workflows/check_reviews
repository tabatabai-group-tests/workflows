name: PR Tech Validation
on: 
  pull_request_review: 
    types: [submitted]

env:
  JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
  GITHUB_TOKEN: ${{ secrets.TEST_GITHUB_PERSONAL_TOKEN }}

jobs:
  compute-reviews-origin:
    runs-on: ubuntu-latest

    steps:
    - name: Flag Issue in Jira
      if: ${{ github.event.review.state == 'CHANGES_REQUESTED' }}
      uses: actions/github-script@v7
      with:
        script: |
          const regex = /DEV-(\d+)/g;
          const ticketNumbers = [];
          let matches;
          while ((matches = regex.exec(${{ github.event.pull_request.title }})) !== null) {
            ticketNumbers.push(matches[1]);
          }

          for (const ticket of ticketNumbers) {
            await fetch(`https://ai6.atlassian.net/rest/api/3/issue/DEV-${ticket}`, {
              method: "PUT",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${{ env.JIRA_API_TOKEN }}`,
              },
              body: JSON.stringify({ "update": { "customfield_10021": [{ "set": [{"value": "Impediment"}] }] }})
            });
          }


    - name: Checkout Repository
      if: ${{ github.event.review.state == 'approved' }}
      uses: actions/checkout@v4
    - name: Setup Node.js
      if: ${{ github.event.review.state == 'approved' }}
      uses: actions/setup-node@v4
      with:
        node-version: '18'

    - name: Get Members of a Github Team
      if: ${{ github.event.review.state == 'approved' }}
      id: members_list
      run: |
        result=$(node .github/scripts/getGithubTeamMembers.js 'chef' '${{ env.GITHUB_TOKEN }}')
        echo "MEMBERS_LIST=$result" >> "$GITHUB_OUTPUT"
      shell: bash

    - name: Get Reviewers of a PR
      if: ${{ github.event.review.state == 'approved' }}
      id: reviewers_list
      run: |
        result=$(node .github/scripts/getPRReviews.js '${{ github.repository }}' '${{ github.event.pull_request.number }}' '${{ env.GITHUB_TOKEN }}')
        echo "REVIEWS=$result" >> "$GITHUB_OUTPUT"
      shell: bash

    - name: Compute Reviewers Role and Jira Transition
      if: ${{ github.event.review.state == 'approved' }}
      id: 'compute_reviewers'
      uses: actions/github-script@v7
      with:
        script: |
          const chefUsers = "${{ steps.members_list.outputs.MEMBERS_LIST }}".split(',');
          
          const objectifChef = 1;
          const objectifDevs = 2;
          let chefReviews = 0;
          let devReviews = 0;
          
          const reviews = ${{ steps.reviewers_list.outputs.REVIEWS }};
          for (const user of reviews.APPROVED_USERS) (chefUsers.includes(user)) ? chefReviews++ : devReviews++;

          if (chefReviews >= objectifChef && devReviews >= objectifDevs && reviews.CHANGES_REQ == 0) {
            const regex = /DEV-(\d+)/g;
            const ticketNumbers = [];
            let matches;
            while ((matches = regex.exec(${{ github.event.pull_request.title }})) !== null) {
              ticketNumbers.push(matches[1]);
            }
            
            for (const ticket of ticketNumbers) {
              await fetch(`https://ai6.atlassian.net/rest/api/3/issue/DEV-${ticket}/transitions`, {
                method: 'POST',
                headers: { 
                  "Accept": "application/json", 
                  "Content-Type": "application/json", 
                  "Authorization": "${{ env.JIRA_API_TOKEN }}" 
                },
                body: JSON.stringify({ "transition": { "id": "5" } })
              });
            }
          }
        result-encoding: string
